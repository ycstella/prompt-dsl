prompt ExtractSteps {
    in {
      Id: int
      Question: string
      Answer: string
    }

	//外部循环
	//loop[,]
	
	//内部循环
	//it_ctx("path")

    output {
      PId:int @model
      Process:struct{
          Id:int
          Question: string
          Solution:struct{
              Step:  int  
              SolutionContent: string 
          } 
          Dificulty: int   @hint("难度1-9整数")
      }     @model
    }

    before{

    }

    sys {
        -你是一位精通小学数学的优秀教师，能够很好地从题目和答案中总结出解答过程和题目难度
    }

    user{
       -以下是题目内容
        in.Question  
        -以下是答案
        in.Answer
        - 给出思考过程，再按json格式返回
        - json格式如下
        outputspec      
    }

	// goimport{

    // }

    fix{

    }

    after{
        p.afterRet.Process=p.fixRet.Process
        return nil
    }
}
